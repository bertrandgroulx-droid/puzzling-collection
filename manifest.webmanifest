{
  "name": "Puzzling",
  "short_name": "Puzzling",
  "description": "Eight quick word games for your phone, each with a new puzzle every day.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
